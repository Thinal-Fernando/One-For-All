{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OFA",
  "version": "0.1.0",
  "identifier": "com.oneforall.ofa",
  "build": {
    "beforeDevCommand": "npm run sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "OFA",
        "width": 380,
        "height": 440,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ofa"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMjEyNjBGQkRGNTM4MzYKUldRMk9QVzlEeVloZzBHT1c1TWs2NjhndC8wL3lVQWc4VEk4Z2hUbFRYRXd2cHhQaW4rbDNiRmQK",
      "endpoints": [
        "https://github.com/Thinal-Fernando/One-For-All/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
